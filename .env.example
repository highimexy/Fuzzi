# Copy to .env (gitignored) and fill in. docker-compose reads this file.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=fuzzi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fuzzi

# ── Backend ───────────────────────────────────────────────────────────────
# Public origin of the frontend — used for CORS. Must match the browser URL.
ALLOWED_ORIGIN=https://twojadomena.pl
# Comma-separated CIDRs/IPs of trusted reverse proxies. Default covers the
# Docker bridge network (nginx). Leave as-is unless your network differs.
TRUSTED_PROXIES=172.16.0.0/12

# ── Auth0 (server-side secrets) ──────────────────────────────────────────
AUTH0_DOMAIN=frontier-one.eu.auth0.com
AUTH0_AUDIENCE=https://api.frontier.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# ── Finnhub (live stocks widget) ─────────────────────────────────────────
# ROTATE this key — the old one leaked into git history.
FINNHUB_API_KEY=your-finnhub-key

# ── Frontend (NEXT_PUBLIC_* are inlined at build time) ───────────────────
# Point this at the public API URL. With the nginx setup that's your domain
# (same origin, /api/v1 path) — NOT an internal hostname.
NEXT_PUBLIC_API_URL=https://twojadomena.pl
NEXT_PUBLIC_AUTH0_DOMAIN=frontier-one.eu.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.frontier.com
