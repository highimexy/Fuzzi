# HTTPS server — ENABLE ONLY AFTER the Let's Encrypt cert exists, otherwise
# nginx fails to start (missing cert files). nginx loads *.conf only, so this
# file is inert until renamed:
#     mv fuzzi-ssl.conf.disabled fuzzi-ssl.conf  &&  docker compose restart nginx
#
# Then switch the :80 server in fuzzi.conf to redirect (see comment there).

server {
    listen 443 ssl;
    http2 on;
    server_name fuzzi.wkowalczyk.pl;

    ssl_certificate     /etc/letsencrypt/live/fuzzi.wkowalczyk.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fuzzi.wkowalczyk.pl/privkey.pem;

    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://fuzzi_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://fuzzi_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_read_timeout 3600s;
    }

    location /uploads/ {
        proxy_pass http://fuzzi_backend;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://fuzzi_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
